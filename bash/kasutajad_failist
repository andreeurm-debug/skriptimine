#!/bin/bash
# Kasutajate lisamise skript failist

if [ $# -ne 1 ]; then
    echo "Kasutusjuhend: $0 failinimi"
    exit 1
fi

failinimi=$1

if [ -f "$failinimi" -a -r "$failinimi" ]; then
    echo "Fail on korras"
    for nimi in $(cat "$failinimi")
    do
        ./lisa_kasutaja "$nimi"
    done
else
    echo "Probleem failiga $failinimi"
fi
