#!/bin/bash
# Kasutajate lisamine kahest eraldi failist

if [ $# -ne 2 ]; then
    echo "Kasutusjuhend: $0 kasutajate_fail paroolide_fail"
    exit 1
fi

kasutajad=$1
paroolid=$2

if [ -f "$kasutajad" -a -r "$kasutajad" ] && [ -f "$paroolid" -a -r "$paroolid" ]; then
    echo "Failid on korras"
    paste -d: "$kasutajad" "$paroolid" | while IFS=: read -r kasutajanimi parool; do
        useradd "$kasutajanimi" -m -s /bin/bash
        if [ $? -eq 0 ]; then
            echo "$kasutajanimi:$parool" | chpasswd
            echo "Kasutaja $kasutajanimi lisatud süsteemi."
        fi
    done
else
    echo "Probleem sisendfailidega"
fi
